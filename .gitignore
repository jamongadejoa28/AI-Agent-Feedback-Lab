# 가상환경
.venv/
env/
venv/

# 환경 변수 및 보안 파일
.env
*.pem
*.key

# SQLite 데이터베이스 및 WAL 파일
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# 피드백 익스포트 결과물 (민감정보 보호)
