data/exports/*.tmp

# Python 캐시 및 빌드 파일
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# 테스트 및 린터 캐시
.pytest_cache/
.coverage
htmlcov/
.pyright/
