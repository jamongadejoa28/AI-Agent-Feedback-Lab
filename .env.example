# First-AI-Agent HTTP 엔드포인트 기본 URL
AGENT_BASE_URL=http://127.0.0.1:8000

# SQLite 데이터베이스 파일 경로
DATABASE_PATH=data/feedback.db

# First-AI-Agent 정책 정의 파일 경로
AGENT_POLICY_PATH=../ai-agent/data/dataset_policy.json

# HTTPS 환경 여부에 따른 세션 쿠키 Secure 속성 (true/false)
COOKIE_SECURE=false

# 서버 구동 호스트 및 포트
HOST=127.0.0.1
PORT=8080

# Agent HTTP 요청 제한 시간 (초)
AGENT_TIMEOUT_SECONDS=30.0
